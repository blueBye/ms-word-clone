{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "jsx": "react-jsx", "declaration": true, "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true, "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"]
}
