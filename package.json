{
  "name": "@local/docx-ir-engine",
  "version": "0.2.0",
  "private": true,
  "description": "Browser-compatible DOCX importer, document IR and React preview renderer",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./docx": {
      "types": "./dist/docx/index.d.ts",
      "import": "./dist/docx/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "npm run build:engine && npm --prefix apps/web run dev",
    "build": "npm run check:pages && npm run build:engine && npm run build:web && npm run verify:pages",
    "build:engine": "tsc -p tsconfig.build.json",
    "build:web": "npm --prefix apps/web run build",
    "start": "node scripts/preview-static.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --prefix apps/web run typecheck",
    "test": "vitest run && node scripts/cloudflare-smoke.mjs",
    "check:pages": "node scripts/check-cloudflare-config.mjs",
    "verify:pages": "node scripts/verify-cloudflare-export.mjs",
    "test:cloudflare": "node scripts/cloudflare-smoke.mjs"
  },
  "dependencies": {
    "@electric-sql/d2ts": "0.1.8",
    "@xmldom/xmldom": "^0.9.8",
    "cfb": "1.2.2",
    "fflate": "^0.8.2",
    "three": "^0.187.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
