{
  "name": "@local/docx-ir-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Client-side DOCX Milestone 1 import and React rendering engine",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./react": { "types": "./dist/react/index.d.ts", "import": "./dist/react/index.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": { "fflate": "^0.8.2", "@xmldom/xmldom": "^0.9.8" },
  "peerDependencies": { "react": ">=18" },
  "devDependencies": { "@types/react": "^18.3.0", "typescript": "^5.6.0", "vitest": "^2.1.0", "react": "^18.3.0" }
}
