{
  "name": "@local/docx-ir-engine",
  "version": "0.2.0",
  "private": true,
  "description": "Browser-compatible DOCX importer, document IR and React preview renderer",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "npm run build:engine && npm --prefix apps/web run dev",
    "build": "npm run build:engine && npm run build:web",
    "build:engine": "tsc -p tsconfig.build.json",
    "build:web": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --prefix apps/web run typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
